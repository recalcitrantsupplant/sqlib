# Git files
.git
.gitignore
.gitattributes

# Node modules (we install them inside the container)
**/node_modules
node_modules

# Build output (created inside the container)
**/dist
dist

# Frontend build artifacts (not needed for API-only container)
packages/web/.nuxt
packages/web/.output
packages/web/dist
packages/web/node_modules
packages/web/coverage
packages/web/playwright-report
packages/web/tests

# Test files and configuration
**/test
**/tests
**/*.test.ts
**/*.test.js
**/*.spec.ts
**/*.spec.js

# ...except under the web UI's source tree, where `tests` is a feature of the
# product and not a test directory: packages/web/src/components/tests/ and
# packages/web/src/pages/tests/ are the test-runs UI, imported by the home
# page. Excluded, they take the web bundle image (Dockerfile.web) down with
# three UNRESOLVED_IMPORT errors. The package's own suites live in
# packages/web/test and packages/web/tests, which stay excluded above.
!packages/web/src/**
**/fuseki-test
fuseki-test
jest.config.js
vitest.config.ts
playwright.config.ts
playwright-report
**/*.tsbuildinfo

# Coverage reports
coverage
.nyc_output

# Local environment files (should be passed as env vars to the container)
.env*
*.env

# Docker files themselves
Dockerfile
Dockerfile.*
.dockerignore
docker-compose*.yml

# Editor/OS specific files
.vscode/
.idea/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.DS_Store

# Development/Documentation/Temporary files
docs/
infrastructure/
traefik/
certs/
packages/api/examples
__blobstorage__/
__queuestorage__/
__azurite_*
*.ts.unused
*.json.copy

# CI/CD
.github/

# Other large files not needed
*.md
README*
LICENSE
.editorconfig
.prettierrc*
.eslintrc*
