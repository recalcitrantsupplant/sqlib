# The web UI as a distributable bundle, not as a server.
#
# `packages/web` is a Nuxt 4 app with `ssr: false`; `nuxt generate` turns it
# into plain files that any static host serves — Azure Static Web Apps, S3 and
# CloudFront, nginx, a CDN. What this image adds is a *name and a version* for
# a particular build of those files: `ghcr.io/<owner>/sqlib-web:0.4.1` is a
# thing you can pull, pin, diff, roll back to and refer to in a deployment
# pipeline, where "the zip somebody built on their laptop" is not.
#
# The image is therefore a carrier, not a runtime. Nothing here serves HTTP.
# Three ways to get the files out:
#
#   # 1. Copy them out of a container that never runs
#   id=$(docker create ghcr.io/<owner>/sqlib-web:<tag>)
#   docker cp "$id":/site ./dist && docker rm "$id"
#
#   # 2. Stream them out (busybox's tar, hence the base below)
#   docker run --rm ghcr.io/<owner>/sqlib-web:<tag> tar -C /site -cf - . | tar -xf - -C ./dist
#
#   # 3. Use it as a build stage in somebody else's image
#   COPY --from=ghcr.io/<owner>/sqlib-web:<tag> /site /usr/share/nginx/html
#
# Nothing environment-specific is baked in. The `NUXT_PUBLIC_*` variables that
# name an environment — the API URL, the OIDC settings, the feature flags — are
# deliberately not passed: the SPA reads `/config.json` from its own origin at
# boot (see docs/guides/deploying.md), so one bundle serves every environment
# and the deployment supplies that one file. A bundle built against a
# particular API would be a bundle per environment, which is the property this
# image exists to avoid.
#
# The three build-stamp variables below are the exception that proves it. They
# say which build this is — version, commit, date — which is a fact about the
# bundle rather than about where it will run, and it cannot be supplied later
# because by then the bundle exists.

# Stage 1: build the static site.
#
# Same base as the server image (Dockerfile) so both track one Node version —
# the glibc-vs-musl reasoning there is about DuckDB and does not apply here,
# but a second Node major to keep in step would.
FROM node:26-bookworm-slim AS builder
WORKDIR /app
ENV NODE_ENV=development

# Corepack was removed from Node core in 25, so pnpm is installed directly.
# Pinned to the root package.json `packageManager` version.
RUN npm install --global pnpm@11.1.2

# Workspace manifests and TypeScript configs — every package's, not just the
# ones this build compiles.
#
# `--frozen-lockfile` validates the lockfile against every importer it names,
# so a missing manifest is a failed install rather than a silent omission.
#
# The tsconfigs are the less obvious half. The root `tsconfig.json` is a
# solution file: `references` to types, contracts and api, and api's own
# config references srl and runtime in turn. Vite resolves a `.vue` file's
# tsconfig by walking that graph, so a *referenced* config that is not in the
# image fails the transform of every page with
# `[TSCONFIG_ERROR] Failed to load tsconfig '../api'` — nine build errors
# about a package this image does not otherwise need. Cheaper to copy ten
# small files than to prune the graph.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.json tsconfig.base.json ./
COPY packages/api/package.json packages/api/tsconfig.json packages/api/
COPY packages/contracts/package.json packages/contracts/tsconfig.json packages/contracts/
COPY packages/mcp-server/package.json packages/mcp-server/tsconfig.json packages/mcp-server/
COPY packages/rdf-delta/package.json packages/rdf-delta/tsconfig.json packages/rdf-delta/
COPY packages/runtime/package.json packages/runtime/tsconfig.json packages/runtime/
COPY packages/runtime-oxigraph/package.json packages/runtime-oxigraph/tsconfig.json packages/runtime-oxigraph/
COPY packages/srl/package.json packages/srl/tsconfig.json packages/srl/
COPY packages/tools/package.json packages/tools/tsconfig.json packages/tools/
COPY packages/types/package.json packages/types/tsconfig.json packages/types/
COPY packages/web/package.json packages/web/tsconfig.json packages/web/

# Web and the workspace packages it depends on, and nothing else: the API's
# dependency tree (DuckDB, Oxigraph) is a few hundred megabytes of download
# that this build has no use for.
RUN pnpm install --frozen-lockfile --filter @sparql-query-lib/web...

# Sources. `packages/web/nuxt.config.ts` aliases @sparql-query-lib/{contracts,
# types,runtime} to their `src/` entry points rather than their `dist/`, so
# these three are copied as source and none of them is built here.
COPY packages/types ./packages/types
COPY packages/contracts ./packages/contracts
COPY packages/runtime ./packages/runtime
COPY packages/web ./packages/web

# What this build is, for the About block the SPA draws from its own bundle.
# Declared before `generate` rather than beside `/bundle-info.json` below,
# because `ssr: false` bakes `NUXT_PUBLIC_*` into the client at build time —
# after the bundle exists there is nothing left to stamp. Without them the
# build falls back to reading git and release-please's manifest, and this image
# has neither: no `.git`, and the manifest is not among the files copied in.
ARG SOURCE_COMMIT=unknown
ARG BUILD_VERSION=unreleased
ARG BUILD_DATE=unknown

# `generate`, not `build`: `build` emits a Nitro server that has to be run with
# Node, which is exactly what this image is not for.
RUN NUXT_PUBLIC_APP_VERSION="$BUILD_VERSION" \
    NUXT_PUBLIC_APP_COMMIT="$SOURCE_COMMIT" \
    NUXT_PUBLIC_BUILD_TIME="$BUILD_DATE" \
    pnpm --filter @sparql-query-lib/web generate

# Fail the build rather than publish a bundle that is not a servable site.
# `ssr: false` plus prerendering is what produces an `index.html` shell here;
# a config change that turned prerendering off would otherwise ship an image
# whose emptiness is only discovered by whoever deploys it.
RUN test -f packages/web/.output/public/index.html \
    || (echo "nuxt generate produced no index.html — see Dockerfile.web" && exit 1)

# Provenance, readable without the daemon that knows the image's labels — after
# `docker cp` the labels are gone and this file is still there. The three args
# are already in scope from above.
RUN printf '{\n  "name": "sqlib-web",\n  "version": "%s",\n  "revision": "%s",\n  "built": "%s"\n}\n' \
      "$BUILD_VERSION" "$SOURCE_COMMIT" "$BUILD_DATE" > /bundle-info.json

# Stage 2: the carrier.
#
# busybox rather than scratch, for about 4MB: `docker cp` and `COPY --from=`
# work either way, but streaming the files out (recipe 2 above) needs a `tar`
# in the image, and `docker run` on a scratch image fails with an exec error
# that reads like a broken image rather than like "this one has nothing to
# run". The CMD below is what `docker run` prints instead.
#
# The payload is architecture-independent — they are text files — and the
# build publishes one architecture, whatever the runner is. That only ever
# matters for the two recipes that execute busybox: recipes 1 and 3 copy
# files and never run anything, while recipe 2 on a foreign architecture
# needs binfmt emulation, or use recipe 1 instead.
FROM busybox:stable-musl
ARG SOURCE_COMMIT=unknown
ARG BUILD_VERSION=unreleased
ARG BUILD_DATE=unknown

LABEL org.opencontainers.image.title="sqlib web UI bundle"
LABEL org.opencontainers.image.description="Static build of the sqlib web UI at /site. A bundle to copy out and deploy, not a server to run."
LABEL org.opencontainers.image.source="https://github.com/recalcitrantsupplant/sqlib"
LABEL org.opencontainers.image.licenses="SEE LICENSE IN LICENSE"
LABEL org.opencontainers.image.version="$BUILD_VERSION"
LABEL org.opencontainers.image.revision="$SOURCE_COMMIT"
LABEL org.opencontainers.image.created="$BUILD_DATE"
# Where the files are, named so a consumer does not have to read this file.
LABEL org.sqlib.bundle.path="/site"

COPY --from=builder /bundle-info.json /bundle-info.json
COPY --from=builder /app/packages/web/.output/public /site

CMD ["sh", "-c", "echo 'This image is a bundle, not a server. The static site is at /site.'; echo; echo '  id=$(docker create <this-image>) && docker cp \"$id\":/site ./dist && docker rm \"$id\"'; echo '  docker run --rm <this-image> tar -C /site -cf - . | tar -xf - -C ./dist'; echo '  COPY --from=<this-image> /site /usr/share/nginx/html'; echo; echo 'Remember /config.json — see docs/guides/deploying.md.'; cat /bundle-info.json"]
