{
  "name": "@sparql-query-lib/cli",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recalcitrantsupplant/sqlib.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/recalcitrantsupplant/sqlib/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/recalcitrantsupplant/sqlib/issues"
  },
  "type": "module",
  "description": "sqlib on the command line: run SPARQL queries, ETL jobs and SHACL 1.2 rule sets in process, with no sqlib server.",
  "bin": {
    "sqlib": "./dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && chmod +x dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1",
    "@sparql-query-lib/compiler": "workspace:*",
    "@sparql-query-lib/runtime": "workspace:*",
    "@sparql-query-lib/runtime-duckdb": "workspace:*",
    "@sparql-query-lib/runtime-etl": "workspace:*",
    "@sparql-query-lib/runtime-oxigraph": "workspace:*",
    "@sparql-query-lib/runtime-srl": "workspace:*",
    "@sparql-query-lib/srl": "workspace:*",
    "oxigraph": "^0.5.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
