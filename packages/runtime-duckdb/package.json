{
  "name": "@sparql-query-lib/runtime-duckdb",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recalcitrantsupplant/sqlib.git",
    "directory": "packages/runtime-duckdb"
  },
  "homepage": "https://github.com/recalcitrantsupplant/sqlib/tree/main/packages/runtime-duckdb#readme",
  "bugs": {
    "url": "https://github.com/recalcitrantsupplant/sqlib/issues"
  },
  "type": "module",
  "description": "A sandboxed DuckDB for sqlib ETL sources: a host-supplied capability profile, locked configuration, and deadlines on every read.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.0-r.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
