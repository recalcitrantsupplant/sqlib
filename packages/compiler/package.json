{
  "name": "@sparql-query-lib/compiler",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recalcitrantsupplant/sqlib.git",
    "directory": "packages/compiler"
  },
  "homepage": "https://github.com/recalcitrantsupplant/sqlib/tree/main/packages/compiler#readme",
  "bugs": {
    "url": "https://github.com/recalcitrantsupplant/sqlib/issues"
  },
  "type": "module",
  "description": "The half of sqlib that needs a SPARQL parser: parse, detect parameters, apply arguments, and compile queries to the templates @sparql-query-lib/runtime splices.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sparql-query-lib/runtime": "workspace:*",
    "@traqula/generator-sparql-1-2": "1.4.0",
    "@traqula/parser-sparql-1-2": "1.4.0",
    "@traqula/rules-sparql-1-2": "1.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
