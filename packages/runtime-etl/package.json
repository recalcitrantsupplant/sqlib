{
  "name": "@sparql-query-lib/runtime-etl",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recalcitrantsupplant/sqlib.git",
    "directory": "packages/runtime-etl"
  },
  "homepage": "https://github.com/recalcitrantsupplant/sqlib/tree/main/packages/runtime-etl#readme",
  "bugs": {
    "url": "https://github.com/recalcitrantsupplant/sqlib/issues"
  },
  "type": "module",
  "description": "The sqlib ETL loop: rows in chunks, mapped to SPARQL bindings, spliced into a CONSTRUCT, and each chunk's RDF handed to a sink.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@sparql-query-lib/runtime": "workspace:*"
  },
  "devDependencies": {
    "@sparql-query-lib/compiler": "workspace:*",
    "@sparql-query-lib/runtime-oxigraph": "workspace:*",
    "@types/node": "^26.6.2",
    "oxigraph": "0.5.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
