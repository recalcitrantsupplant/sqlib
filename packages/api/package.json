{
  "name": "@sparql-query-lib/api",
  "version": "1.0.0",
  "private": true,
  "description": "Fastify backend for the SPARQL Query Library",
  "main": "./dist/index.js",
  "type": "module",
  "scripts": {
    "seed:system-library": "tsx scripts/seed-system-library.ts",
    "dev": "NODE_ENV=development OTEL_ENABLED=false RULESET_CANON_DEBUG=true tsx watch src/index.ts",
    "dev:observability": "docker compose -f ../../docker-compose.dev.yml up -d",
    "dev:full": "npm run dev:observability && npm run dev",
    "dev:stop": "docker compose -f ../../docker-compose.dev.yml down",
    "lint": "echo \"TODO: add lint\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:clean": "rm -rf node_modules/.vite && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "generate-schemas": "tsx scripts/generate-schemas.ts",
    "smoke:provider": "tsx scripts/assistant-provider-smoke.ts",
    "smoke:etl-extensions": "tsx scripts/etl-extension-smoke.ts",
    "smoke:storage": "tsx scripts/storage-writability-smoke.ts",
    "build": "tsx scripts/generate-schemas.ts && tsc --project tsconfig.build.json",
    "export:bundle": "tsx scripts/export-bundle.ts",
    "export:library-store": "tsx scripts/export-library-store.ts",
    "import:library-store": "tsx scripts/import-library-store.ts",
    "clean": "rm -rf dist && find test scripts -type f \\( -name '*.js' -o -name '*.js.map' \\) -delete",
    "clean:test": "find test -type f \\( -name '*.js' -o -name '*.js.map' \\) -delete",
    "clean:scripts": "find scripts -type f \\( -name '*.js' -o -name '*.js.map' \\) -delete",
    "migrate:grammar-type": "tsx scripts/migrate-grammar-type-to-srl.ts",
    "backfill:srl-importable": "tsx scripts/backfill-srl-importable.ts"
  },
  "keywords": [],
  "author": "",
  "license": "SEE LICENSE IN LICENSE",
  "earlReport": {
    "$comment": "Identity for W3C EARL conformance reports - see docs/guides/testing-and-conformance.md. The npm fields above (name, version, description, homepage, repository, author) fill in the rest, so a release is described once.",
    "projectName": "sqlib",
    "projectIri": "urn:sqlib:software",
    "programmingLanguages": [
      "TypeScript"
    ],
    "suiteBaseIri": "https://w3c.github.io/rdf-tests/shacl/shacl12/"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.49",
    "@ai-sdk/groq": "^4.0.37",
    "@ai-sdk/openai": "^4.0.60",
    "@duckdb/node-api": "1.5.5-r.4",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/otel": "^0.21.0",
    "@fastify/swagger": "^9.8.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.222.0",
    "@opentelemetry/auto-instrumentations-node": "^0.80.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-http": "^0.222.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-logs": "^0.222.0",
    "@opentelemetry/sdk-metrics": "^2.11.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@rdfjs/data-model": "^2.1.2",
    "@sparql-query-lib/contracts": "workspace:*",
    "@sparql-query-lib/rdf-delta": "workspace:*",
    "@sparql-query-lib/runtime": "workspace:*",
    "@sparql-query-lib/srl": "workspace:*",
    "@sparql-query-lib/tools": "workspace:*",
    "@sparql-query-lib/types": "workspace:*",
    "@traqula/core": "1.2.0",
    "@traqula/generator-sparql-1-2": "1.2.1",
    "@traqula/parser-sparql-1-2": "1.2.1",
    "@traqula/rules-sparql-1-1": "1.2.1",
    "@traqula/rules-sparql-1-2": "1.2.1",
    "@types/rdfjs__data-model": "^2.0.9",
    "ai": "^7.0.91",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.3",
    "jose": "^6.2.12",
    "jsonld": "^9.0.0",
    "oxigraph": "^0.5.11",
    "rdf-canonize": "^5.0.0",
    "rdf-data-factory": "^2.0.2",
    "undici": "^8.10.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/jsonld": "^1.5.15",
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.0",
    "fast-check": "^4.10.0",
    "json-schema-to-ts": "^3.1.1",
    "supertest": "^7.2.2",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
