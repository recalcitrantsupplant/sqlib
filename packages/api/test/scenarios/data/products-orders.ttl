# Scenario 4: Ephemeral Store Operations - Product Catalog and Order Data
# Flow: Use ephemeral stores for intermediate data processing

@prefix ex: <http://example.org/> .
@prefix schema: <http://schema.org/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Product Categories
ex:electronics a ex:Category ;
    rdfs:label "Electronics" ;
    ex:description "Electronic devices and accessories" .

ex:clothing a ex:Category ;
    rdfs:label "Clothing" ;
    ex:description "Apparel and fashion items" .

ex:books a ex:Category ;
    rdfs:label "Books" ;
    ex:description "Books and educational materials" .

ex:homeGarden a ex:Category ;
    rdfs:label "Home & Garden" ;
    ex:description "Home improvement and garden supplies" .

# Brands
ex:brandApple a ex:Brand ;
    rdfs:label "Apple" ;
    ex:country "USA" ;
    ex:foundedYear 1976 .

ex:brandSamsung a ex:Brand ;
    rdfs:label "Samsung" ;
    ex:country "South Korea" ;
    ex:foundedYear 1938 .

ex:brandNike a ex:Brand ;
    rdfs:label "Nike" ;
    ex:country "USA" ;
    ex:foundedYear 1964 .

ex:brandAdidas a ex:Brand ;
    rdfs:label "Adidas" ;
    ex:country "Germany" ;
    ex:foundedYear 1949 .

ex:brandPenguin a ex:Brand ;
    rdfs:label "Penguin Random House" ;
    ex:country "USA" ;
    ex:foundedYear 1927 .

