# Inventory Tracking
ex:inventory001 a ex:InventoryRecord ;
    ex:product ex:prod001 ;
    ex:warehouse ex:warehouseWest ;
    ex:quantityOnHand 150 ;
    ex:reservedQuantity 25 ;
    ex:availableQuantity 125 ;
    ex:reorderPoint 50 ;
    ex:lastUpdated "2024-01-30T10:30:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .

ex:inventory002 a ex:InventoryRecord ;
    ex:product ex:prod002 ;
    ex:warehouse ex:warehouseEast ;
    ex:quantityOnHand 200 ;
    ex:reservedQuantity 15 ;
    ex:availableQuantity 185 ;
    ex:reorderPoint 75 ;
    ex:lastUpdated "2024-01-30T10:30:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime> .

