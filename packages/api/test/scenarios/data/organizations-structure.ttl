# Scenario 2: Multi-Path Aggregation - Organizations, Departments, and Employees
# Flow: Split by departments → Process each → Merge results

@prefix ex: <http://example.org/> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix schema: <http://schema.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Organization
ex:techCorpInc a org:Organization ;
    rdfs:label "TechCorp Inc." ;
    ex:foundedYear 2010 ;
    ex:industry "Technology" ;
    ex:headquarters "San Francisco, CA" ;
    ex:revenue "100000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:employeeCount 150 .

# Departments
ex:engineeringDept a org:OrganizationalUnit ;
    rdfs:label "Engineering Department" ;
    org:unitOf ex:techCorpInc ;
    ex:budget "15000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:headcount 45 ;
    ex:location "Building A, Floor 3" .

ex:marketingDept a org:OrganizationalUnit ;
    rdfs:label "Marketing Department" ;
    org:unitOf ex:techCorpInc ;
    ex:budget "8000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:headcount 25 ;
    ex:location "Building B, Floor 2" .

ex:salesDept a org:OrganizationalUnit ;
    rdfs:label "Sales Department" ;
    org:unitOf ex:techCorpInc ;
    ex:budget "12000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:headcount 35 ;
    ex:location "Building B, Floor 1" .

ex:hrDept a org:OrganizationalUnit ;
    rdfs:label "Human Resources Department" ;
    org:unitOf ex:techCorpInc ;
    ex:budget "3000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:headcount 12 ;
    ex:location "Building A, Floor 1" .

ex:financeDept a org:OrganizationalUnit ;
    rdfs:label "Finance Department" ;
    org:unitOf ex:techCorpInc ;
    ex:budget "5000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:headcount 18 ;
    ex:location "Building A, Floor 2" .

ex:operationsDept a org:OrganizationalUnit ;
    rdfs:label "Operations Department" ;
    org:unitOf ex:techCorpInc ;
    ex:budget "6000000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:headcount 15 ;
    ex:location "Building C, Floor 1" .

# Engineering Department Employees
ex:emp001 a foaf:Person ;
    foaf:name "Sarah Chen" ;
    org:memberOf ex:engineeringDept ;
    ex:jobTitle "Senior Software Engineer" ;
    ex:salary "120000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:hireDate "2018-03-15"^^<http://www.w3.org/2001/XMLSchema#date> ;
    ex:performanceRating "excellent" ;
    ex:yearsExperience 8 .

ex:emp002 a foaf:Person ;
    foaf:name "Mike Rodriguez" ;
    org:memberOf ex:engineeringDept ;
    ex:jobTitle "DevOps Engineer" ;
    ex:salary "115000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:hireDate "2019-07-22"^^<http://www.w3.org/2001/XMLSchema#date> ;
    ex:performanceRating "excellent" ;
    ex:yearsExperience 6 .

ex:emp003 a foaf:Person ;
    foaf:name "Emily Davis" ;
    org:memberOf ex:engineeringDept ;
    ex:jobTitle "Frontend Developer" ;
    ex:salary "95000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:hireDate "2020-11-10"^^<http://www.w3.org/2001/XMLSchema#date> ;
    ex:performanceRating "good" ;
    ex:yearsExperience 4 .

ex:emp004 a foaf:Person ;
    foaf:name "James Wilson" ;
    org:memberOf ex:engineeringDept ;
    ex:jobTitle "Engineering Manager" ;
    ex:salary "140000"^^<http://www.w3.org/2001/XMLSchema#decimal> ;
    ex:hireDate "2017-01-08"^^<http://www.w3.org/2001/XMLSchema#date> ;
    ex:performanceRating "excellent" ;
    ex:yearsExperience 12 .

