{
  "name": "@sparql-query-lib/contracts",
  "version": "0.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "import": "./dist/schema/index.js",
      "require": "./dist/schema/index.cjs"
    },
    "./schema/routes": {
      "import": "./dist/schema/routes.js",
      "require": "./dist/schema/routes.cjs"
    },
    "./iri": {
      "import": "./dist/iri.js",
      "require": "./dist/iri.cjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/schema/index.ts src/schema/routes.ts src/iri.ts --format esm,cjs --clean false && tsc --project tsconfig.json --emitDeclarationOnly",
    "lint": "echo 'TODO: add lint script'",
    "test": "echo 'TODO: add tests'"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  }
}
