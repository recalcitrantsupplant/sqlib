## Proposed additions to the SPARQL-RL test suite: order inside a NOT.
## Same layout and vocabulary as wellformed/manifest.ttl upstream.

PREFIX :       <manifest#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Well-formedness: order inside a NOT (proposed)" ;
    mf:entries (
        :test_1
        :test_2
        :test_3
    ) .

:test_1 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-neg-order-01.srl" ;
   mf:action  <wellformed-neg-order-01.srl> ;
   .

:test_2 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-neg-order-bad-01.srl" ;
   mf:action  <wellformed-neg-order-bad-01.srl> ;
   .

:test_3 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-neg-order-bad-02.srl" ;
   mf:action  <wellformed-neg-order-bad-02.srl> ;
   .
