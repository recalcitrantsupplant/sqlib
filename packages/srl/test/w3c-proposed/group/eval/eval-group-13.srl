PREFIX :    <http://example/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
# Changed from notes-1347/proposed-tests.html: WHERE DATA rather than WHERE.
# The head ?t ?st ?n can generate a triple matching ?t :owns ?c in the group
# pattern, a closed dependency of the rule on itself, so with WHERE the rule
# set is not stratifiable. WHERE DATA removes the dependency, and on this data
# the result is the same.
RULE { ?t ?st ?n } WHERE DATA {
    ?t rdf:type :Team
    GROUP BY ?t ?st { ?t :owns ?c . ?c :status ?st } [ ?n := COUNT(*) ]
}
