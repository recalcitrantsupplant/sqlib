## Proposed SPARQL-RL tests for GROUP, from data-shapes notes-1347/proposed-tests.html.
## Same layout and vocabulary as wellformed/manifest.ttl upstream.

PREFIX :       <manifest#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Well-formedness: GROUP (proposed)" ;
    mf:entries (
        :wellformed-group-01
        :wellformed-group-02
        :wellformed-group-03
        :wellformed-group-04
        :wellformed-group-05
        :wellformed-group-06
        :wellformed-group-07
        :wellformed-group-08
        :wellformed-group-09
        :wellformed-group-10
        :wellformed-group-11
        :wellformed-group-bad-01
        :wellformed-group-bad-02
        :wellformed-group-bad-03
        :wellformed-group-bad-04
        :wellformed-group-bad-05
        :wellformed-group-bad-06
        :wellformed-group-bad-07
        :wellformed-group-bad-08
        :wellformed-group-bad-09
        :wellformed-group-bad-10
        :wellformed-group-bad-11
        :wellformed-group-bad-12
        :wellformed-group-bad-13
        :wellformed-group-bad-14
        :wellformed-group-bad-15
    ) .


# A key bound only by the pattern.
:wellformed-group-01 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-01.srl" ;
   mf:action  <wellformed-group-01.srl> ;
   .

# A key bound only before the GROUP and not used in the pattern.
:wellformed-group-02 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-02.srl" ;
   mf:action  <wellformed-group-02.srl> ;
   .

# An earlier variable that is not a key is used in the head.
:wellformed-group-03 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-03.srl" ;
   mf:action  <wellformed-group-03.srl> ;
   .

# A pattern variable with the same name as an earlier variable that is not a key.
:wellformed-group-04 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-04.srl" ;
   mf:action  <wellformed-group-04.srl> ;
   .

# A FILTER in the pattern uses a key bound before the GROUP.
:wellformed-group-05 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-05.srl" ;
   mf:action  <wellformed-group-05.srl> ;
   .

# An aggregation argument that is a key bound before the GROUP.
:wellformed-group-06 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-06.srl" ;
   mf:action  <wellformed-group-06.srl> ;
   .

# A SET in the pattern assigns a name that is bound outside but is not a key.
:wellformed-group-07 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-07.srl" ;
   mf:action  <wellformed-group-07.srl> ;
   .

# A key computed by a SET in the pattern.
:wellformed-group-08 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-08.srl" ;
   mf:action  <wellformed-group-08.srl> ;
   .

# The first GROUP's result reaches the head through a second GROUP.
:wellformed-group-09 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-09.srl" ;
   mf:action  <wellformed-group-09.srl> ;
   .

# Two GROUPs each have a pattern variable called ?y.
:wellformed-group-10 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-10.srl" ;
   mf:action  <wellformed-group-10.srl> ;
   .

# A later SET reads an aggregation variable.
:wellformed-group-11 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-11.srl" ;
   mf:action  <wellformed-group-11.srl> ;
   .

# A key that is bound neither before the GROUP nor by the pattern.
:wellformed-group-bad-01 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-01.srl" ;
   mf:action  <wellformed-group-bad-01.srl> ;
   .

# An aggregation variable that is a pattern variable.
:wellformed-group-bad-02 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-02.srl" ;
   mf:action  <wellformed-group-bad-02.srl> ;
   .

# An aggregation variable bound before the GROUP.
:wellformed-group-bad-03 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-03.srl" ;
   mf:action  <wellformed-group-bad-03.srl> ;
   .

# An aggregation variable that is a key.
:wellformed-group-bad-04 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-04.srl" ;
   mf:action  <wellformed-group-bad-04.srl> ;
   .

# The same aggregation variable twice in one block.
:wellformed-group-bad-05 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-05.srl" ;
   mf:action  <wellformed-group-bad-05.srl> ;
   .

# An aggregation argument bound nowhere.
:wellformed-group-bad-06 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-06.srl" ;
   mf:action  <wellformed-group-bad-06.srl> ;
   .

# An aggregation argument bound before the GROUP but not listed as a key.
:wellformed-group-bad-07 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-07.srl" ;
   mf:action  <wellformed-group-bad-07.srl> ;
   .

# A FILTER in the pattern uses an earlier variable that is not a key.
:wellformed-group-bad-08 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-08.srl" ;
   mf:action  <wellformed-group-bad-08.srl> ;
   .

# A SET in the pattern reads an earlier variable that is not a key.
:wellformed-group-bad-09 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-09.srl" ;
   mf:action  <wellformed-group-bad-09.srl> ;
   .

# A SET in the pattern assigns a key bound before the GROUP.
:wellformed-group-bad-10 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-10.srl" ;
   mf:action  <wellformed-group-bad-10.srl> ;
   .

# A variable bound only in the pattern is used in the head.
:wellformed-group-bad-11 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-11.srl" ;
   mf:action  <wellformed-group-bad-11.srl> ;
   .

# A variable bound only in the pattern is used in a later FILTER.
:wellformed-group-bad-12 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-12.srl" ;
   mf:action  <wellformed-group-bad-12.srl> ;
   .

# A later SET assigns an aggregation variable.
:wellformed-group-bad-13 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-13.srl" ;
   mf:action  <wellformed-group-bad-13.srl> ;
   .

# A second GROUP reuses the first one's aggregation variable.
:wellformed-group-bad-14 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-14.srl" ;
   mf:action  <wellformed-group-bad-14.srl> ;
   .

# A FILTER in the pattern uses the block's own aggregation variable.
:wellformed-group-bad-15 rdf:type   srlt:RulesNegativeWellFormednessTest ;
   mf:name    "wellformed-group-bad-15.srl" ;
   mf:action  <wellformed-group-bad-15.srl> ;
   .
