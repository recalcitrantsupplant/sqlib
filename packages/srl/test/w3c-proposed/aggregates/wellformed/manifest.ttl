## Proposed SPARQL-RL tests for GROUP (w3c/data-shapes#1344, #1347).
## Same layout and vocabulary as wellformed/manifest.ttl upstream.

PREFIX :       <manifest#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Well-formedness: GROUP (proposed)" ;
    mf:entries (
        :test_1
        :test_2
        :test_3
        :test_4
        :test_5
        :test_6
        :test_7
        :test_8
        :test_9
        :test_10
        :test_11
        :test_12
        :test_13
        :test_14
        :test_15
        :test_16
        :test_17
        :test_18
        :test_19
        :test_20
        :test_21
        :test_22
    ) .

:test_1 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-agg-01.srl" ;
   mf:action  <wellformed-group-agg-01.srl> ;
   .

:test_2 rdf:type   srlt:RulesPositiveWellFormednessTest ;
   mf:name    "wellformed-group-agg-02.srl" ;
   mf:action  <wellformed-group-agg-02.srl> ;
   .

