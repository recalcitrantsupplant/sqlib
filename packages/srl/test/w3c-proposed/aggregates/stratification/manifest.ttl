## Proposed SPARQL-RL tests for aggregates (w3c/data-shapes#840).
## Same layout and vocabulary as stratification/manifest.ttl upstream.

PREFIX :       <manifest#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Stratification: AGGREGATE (proposed)" ;
    mf:entries (
        :test_1
        :test_2
        :test_3
        :test_4
        :test_5
        :test_6
    ) .

:test_1 rdf:type   srlt:RulesPositiveStratificationTest ;
   mf:name    "stratification-aggregate-01.srl" ;
   mf:action  <stratification-aggregate-01.srl> ;
   .

:test_2 rdf:type   srlt:RulesPositiveStratificationTest ;
   mf:name    "stratification-aggregate-02.srl" ;
   mf:action  <stratification-aggregate-02.srl> ;
   .

:test_3 rdf:type   srlt:RulesPositiveStratificationTest ;
   mf:name    "stratification-aggregate-03.srl" ;
   mf:action  <stratification-aggregate-03.srl> ;
   .

:test_4 rdf:type   srlt:RulesNegativeStratificationTest ;
   mf:name    "stratification-aggregate-bad-01.srl" ;
   mf:action  <stratification-aggregate-bad-01.srl> ;
   .

:test_5 rdf:type   srlt:RulesNegativeStratificationTest ;
   mf:name    "stratification-aggregate-bad-02.srl" ;
   mf:action  <stratification-aggregate-bad-02.srl> ;
   .

:test_6 rdf:type   srlt:RulesNegativeStratificationTest ;
   mf:name    "stratification-aggregate-bad-03.srl" ;
   mf:action  <stratification-aggregate-bad-03.srl> ;
   .
