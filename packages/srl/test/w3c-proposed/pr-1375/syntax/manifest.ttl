## The GROUP syntax tests of the W3C SPARQL-RL suite as they stand on
## w3c/data-shapes#1375 (branch srl-aggregation-comma), commit
## a3eac70d93f94007f23d99c328f667c0e6a0b271, which puts a comma between
## aggregation assignments. Files copied unedited; entries keep the upstream
## ids and types.

PREFIX :       <manifest#>
PREFIX rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs:   <http://www.w3.org/2000/01/rdf-schema#>
PREFIX mf:     <http://www.w3.org/2001/sw/DataAccess/tests/test-manifest#>
PREFIX srlt:   <http://www.w3.org/ns/sparql-rl-tests#>

<>  rdf:type mf:Manifest ;
    rdfs:comment "SPARQL-RL - Syntax: GROUP (w3c/data-shapes#1375)" ;
    mf:entries (
        :test_35
        :test_36
        :test_37
        :test_38
        :test_39
        :test_40
        :test_41
        :test_42
        :test_43
        :test_44
