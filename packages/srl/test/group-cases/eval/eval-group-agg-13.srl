PREFIX : <http://example/>

# On an empty graph a GROUP with no BY still has its one implicit group, so
# COUNT gives 0. MAX fails on the empty group, so it gives no value
# (w3c/data-shapes#1377).
RULE { :all :count ?n } WHERE { GROUP { ?s :p ?o } [ ?n := COUNT(*) ] }
RULE { :all :max ?m } WHERE { GROUP { ?s :p ?o } [ ?m := MAX(?o) ] }
