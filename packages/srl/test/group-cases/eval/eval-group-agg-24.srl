PREFIX : <http://example/>

# A pattern after the GROUP binds a new variable, ?y, for the head. The
# pattern counts children with its own ?c: reusing ?y there is ill-formed
# since w3c/data-shapes#690 (wellformed-group-agg-09).
RULE { ?x :named ?y ; :kids ?n } WHERE { ?x a :Person . GROUP BY ?x { ?c :childOf ?x } [ ?n := COUNT(*) ] ?x :name ?y }
