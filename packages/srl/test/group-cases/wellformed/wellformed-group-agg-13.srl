PREFIX : <http://example/>

# The pattern may not use ?y, which is bound before the GROUP and is not a
# key: only the BY variables are shared, so the name is in use inside the
# pattern (w3c/data-shapes#690).
RULE { ?x :n ?n } WHERE { ?x a :Person ; :knows ?y . GROUP BY ?x { ?y :childOf ?x } [ ?n := COUNT(*) ] }
