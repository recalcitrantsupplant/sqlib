{
  "name": "@sparql-query-lib/srl",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/recalcitrantsupplant/sqlib.git",
    "directory": "packages/srl"
  },
  "homepage": "https://github.com/recalcitrantsupplant/sqlib/tree/main/packages/srl#readme",
  "bugs": {
    "url": "https://github.com/recalcitrantsupplant/sqlib/issues"
  },
  "type": "module",
  "description": "SHACL 1.2 Shape Rules Language (SRL) — parser, generator, SPARQL-UPDATE compiler and stratifier, built as a Traqula grammar extension.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@traqula/core": "1.3.0",
    "@traqula/generator-sparql-1-2": "1.4.0",
    "@traqula/parser-sparql-1-2": "1.4.0",
    "@traqula/rules-sparql-1-1": "1.4.0",
    "@traqula/rules-sparql-1-2": "1.4.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
