{
  "name": "sparql-query-lib",
  "version": "1.0.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @sparql-query-lib/api dev",
    "dev:observability": "pnpm --filter @sparql-query-lib/api dev:observability",
    "dev:full": "pnpm --filter @sparql-query-lib/api dev:full",
    "dev:stop": "pnpm --filter @sparql-query-lib/api dev:stop",
    "test": "pnpm --filter @sparql-query-lib/api test",
    "generate-schemas": "pnpm --filter @sparql-query-lib/api generate-schemas",
    "any:count": "node scripts/count-any.mjs",
    "any:update": "node scripts/count-any.mjs --update",
    "build": "pnpm -r build",
    "lint": "node scripts/lint-ratchet.mjs",
    "lint:update": "node scripts/lint-ratchet.mjs --update",
    "ci": "bash scripts/ci/all.sh"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
