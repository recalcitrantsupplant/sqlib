# The `auth` profile: sqlib behind Rauthy, the reference broker.
#
#   cp .env.auth.example .env      # then fill in the secrets below
#   docker compose -f docker-compose.mcp-https-image.yml --profile auth up
#
# See docs/guides/deploying.md#the-local-auth-profile. Nothing here is used
# without `--profile auth`, except the SQLIB_AUTH_* lines, which turn
# authentication on for the `app` service.

# --- Rauthy's own secrets. Generate each once and keep them. ----------------
# openssl rand -hex 16
RAUTHY_SECRET_RAFT=
# openssl rand -hex 16
RAUTHY_SECRET_API=
# An id (letters, digits, `_`, `-`, 2 to 20 characters) and a key:
#   echo "$(openssl rand -hex 4)/$(openssl rand -base64 32)"
# RAUTHY_ENC_KEY is the whole line; RAUTHY_ENC_KEY_ID is the part before `/`.
RAUTHY_ENC_KEY=
RAUTHY_ENC_KEY_ID=
# The password of admin@localhost, Rauthy's administrator and the first user.
RAUTHY_ADMIN_PASSWORD=
# The secret of the API key rauthy-setup uses (64 or more characters):
#   openssl rand -hex 32
RAUTHY_API_KEY_SECRET=

# --- sqlib ------------------------------------------------------------------
SQLIB_AUTH_MODE=required
# What a token must carry in `aud`: the canonical URL of /mcp. rauthy-setup
# puts it in every client's `allowed_resources` and `default_aud`.
SQLIB_AUTH_RESOURCE=https://localhost:3443/mcp
SQLIB_AUTH_AUDIENCE=https://localhost:3443/mcp
# The browser reaches Rauthy at localhost:8080, and that is the issuer the
# tokens name. The app container fetches the keys over the compose network.
SQLIB_AUTH_ISSUER=http://localhost:8080/auth/v1/
SQLIB_AUTH_JWKS_URI=http://rauthy:8080/auth/v1/oidc/certs
SQLIB_AUTH_CLAIM_GROUPS=groups
# Rauthy puts its administrator in the `admin` group.
SQLIB_AUTH_ADMIN_PRINCIPALS=http://localhost:8080/auth/v1/|group:admin
# The SPA's origin, so it may call the API.
SQLIB_CORS_ORIGINS=http://localhost:3001
# Where the SPA is served; rauthy-setup registers <origin>/auth/callback.
SQLIB_WEB_ORIGINS=http://localhost:3001

# --- Upstream providers (optional) -------------------------------------------
# Each is created when its client id is set. Register this redirect URL at the
# provider: http://localhost:8080/auth/v1/providers/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Entra ID: https://login.microsoftonline.com/<tenant id>/v2.0
ENTRA_ISSUER=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# AAF: the federation's OIDC issuer, for example https://central.test.aaf.edu.au
AAF_ISSUER=
AAF_CLIENT_ID=
AAF_CLIENT_SECRET=
