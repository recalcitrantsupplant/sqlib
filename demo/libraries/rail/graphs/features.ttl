# from the network graph, which the tests read.

:red :route [ geo:asWKT "LINESTRING(115.967 -31.94, 115.88 -31.92, 115.86 -31.951, 115.852 -31.956, 115.84 -31.985, 115.845 -32.01)"^^geo:wktLiteral ] .
:blue :route [ geo:asWKT "LINESTRING(115.79 -31.94, 115.825 -31.935, 115.86 -31.951, 115.872 -31.948, 115.818 -31.978, 115.92 -31.962)"^^geo:wktLiteral ] .
:green :route [ geo:asWKT "LINESTRING(115.9 -31.915, 115.872 -31.948, 115.852 -31.956, 115.88 -31.97, 115.9 -31.995, 115.915 -32.015)"^^geo:wktLiteral ] .
:yellow :route [ geo:asWKT "LINESTRING(115.77 -31.93, 115.825 -31.935, 115.88 -31.92, 115.9 -31.915)"^^geo:wktLiteral ] .
