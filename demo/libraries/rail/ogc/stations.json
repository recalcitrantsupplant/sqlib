{
  "query": "urn:sqlib:query:rail-stations-features",
  "collectionId": "stations",
  "title": "Stations",
  "description": "Every station, as a point, with its zone and step-free access.",
  "mode": "values",
  "feature": {
    "var": "feature",
    "base": "https://example.org/rail/"
  },
  "geometry": "geom",
  "params": {
    "limit": "1",
    "offset": "2",
    "bbox": [
      "minx",
      "miny",
      "maxx",
      "maxy"
    ],
    "skipGeometry": "skip"
  },
  "queryables": {
    "name": {
      "var": "nameLike",
      "type": "string",
      "title": "Name"
    },
    "zone": {
      "var": "zoneIn",
      "type": "integer",
      "title": "Zone"
    },
    "stepFree": {
      "var": "stepFreeIn",
      "type": "boolean",
      "title": "Step-free"
    }
  },
  "pageSize": {
    "default": 10,
    "max": 100
  },
  "extent": {
    "spatial": [
      [
        115.76,
        -32.025,
        115.977,
        -31.905
      ]
    ]
  },
  "valuesQuery": "urn:sqlib:query:rail-station-facets",
  "context": {
    "name": {
      "@id": "https://example.org/rail/name"
    },
    "zone": {
      "@id": "https://example.org/rail/zone",
      "@type": "http://www.w3.org/2001/XMLSchema#integer"
    },
    "stepFree": {
      "@id": "https://example.org/rail/stepFree",
      "@type": "http://www.w3.org/2001/XMLSchema#boolean"
    }
  }
}
