  "argumentSets": [
    {
      "key": "red",
      "name": "Red line",
      "targetId": "urn:sqlib:query:sqlib-tutorial-01-1",
      "scope": "query",
      "description": "?line is the Red line.",
      "tupleBindings": [
        {
          "variables": [
            "line"
          ],
          "rows": [
            {
              "values": {
                "line": {
                  "type": "uri",
                  "value": "https://example.org/rail/red"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "key": "red-and-green",
      "name": "Red and Green lines",
      "targetId": "urn:sqlib:query:sqlib-tutorial-01-1",
      "scope": "query",
      "description": "?line is the Red line or the Green line: two rows in one argument.",
      "tupleBindings": [
        {
          "variables": [
            "line"
          ],
          "rows": [
            {
              "values": {
                "line": {
                  "type": "uri",
                  "value": "https://example.org/rail/red"
                }
              }
            },
            {
              "values": {
                "line": {
                  "type": "uri",
                  "value": "https://example.org/rail/green"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "key": "zones-1-2",
      "name": "Zones 1 and 2",
      "targetId": "urn:sqlib:query:sqlib-tutorial-01-exercise",
      "scope": "query",
      "description": "?zone is 1 or 2.",
      "tupleBindings": [
        {
          "variables": [
            "zone"
          ],
          "rows": [
            {
              "values": {
                "zone": {
                  "type": "literal",
                  "value": "1",
                  "datatype": "http://www.w3.org/2001/XMLSchema#integer"
                }
              }
            },
            {
              "values": {
                "zone": {
                  "type": "literal",
                  "value": "2",
                  "datatype": "http://www.w3.org/2001/XMLSchema#integer"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "key": "airport-central-before-1950",
      "name": "Airport to Central, lines before 1950",
      "targetId": "urn:sqlib:query:sqlib-tutorial-02-1",
      "scope": "query",
      "description": "(?from ?to) is Airport to Central, and ?before is 1950.",
      "tupleBindings": [
        {
          "variables": [
            "from",
            "to"
          ],
          "rows": [
            {
              "values": {
                "from": {
                  "type": "uri",
