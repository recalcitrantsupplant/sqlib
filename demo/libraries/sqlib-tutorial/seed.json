          "variables": [
            "before"
          ],
          "rows": [
            {
              "values": {
                "before": {
                  "type": "literal",
                  "value": "1950",
                  "datatype": "http://www.w3.org/2001/XMLSchema#integer"
                }
              }
            }
          ]
        }
      ]
    },
