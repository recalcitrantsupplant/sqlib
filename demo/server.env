# The demo server's settings: read-only, anonymous auth and demo mode, with the
# store that demo/scripts/seed.sh built. Dockerfile.demo reads these paths.
# `just demo` overrides the paths, the port and NODE_ENV.
NODE_ENV=production
APP_MODE=dual-http
HTTP_HOST=0.0.0.0
HTTP_PORT=3000
OTEL_ENABLED=false
INTERNAL_BACKEND_TYPE=sqlite
LIBRARY_STORAGE_DIR=/opt/sqlib-demo/store
CACHE_WRITE_THROUGH=true
CACHE_PRELOAD=true
ENABLE_OXIGRAPH=true
OXIGRAPH_STORAGE_DIR=/app/packages/api/storage/oxigraph
SQLIB_READ_ONLY=true
SQLIB_AUTH_MODE=anonymous
SQLIB_DEMO=true
SQLIB_DEMO_PEOPLE=/opt/sqlib-demo/people.json
SQLIB_AUTH_STORE_TYPE=sqlite
SQLIB_AUTH_STORE_DIR=/opt/sqlib-demo/auth
SQLIB_AUTH_SEED_GRANTS=/opt/sqlib-demo/grants.ttl
SQLIB_AUTH_ALLOW_LIBRARY_CREATE=admin
MCP_READ_ONLY=true
MCP_SPARQL_ENDPOINTS=backends-only
ETL_OUTPUT_DIR=/opt/sqlib-demo/etl-output
ETL_DUCKDB_ALLOW_FILESYSTEM=false
ETL_DUCKDB_ALLOW_HTTP=false
ETL_DUCKDB_ALLOW_EXTENSION_INSTALL=false
SQLIB_EXECUTION_TIMEOUT_MS=5000
SQLIB_QUERY_WORKERS=2
SQLIB_PLAYGROUND_RULE_RUNS=1
SQLIB_READ_ONLY_BENCH_MAX_REQUESTS=200
SQLIB_READ_ONLY_BENCH_MAX_CONCURRENCY=2
SQLIB_READ_ONLY_BENCH_DEADLINE_MS=60000
SQLIB_READ_ONLY_BENCH_CONCURRENT_RUNS=1
SQLIB_READ_ONLY_ETL_MAX_ROWS=100000
FEATURE_QUERIES=true
FEATURE_QUERY_GROUPS=true
FEATURE_RULES_SUITE=true
FEATURE_BENCHMARKS=true
FEATURE_TESTS=true
FEATURE_DATA_GRAPHS=true
FEATURE_TUPLE_SETS=true
FEATURE_ARGUMENT_SETS=true
FEATURE_NOTEBOOK=true
FEATURE_BUILD=false
FEATURE_ETL=true
FEATURE_BACKENDS=true
FEATURE_SETTINGS=false
FEATURE_RULES_ALLOW_INVALID_SAVE=false
FEATURE_RULE_TUPLES=false
FEATURE_RULE_AGGREGATES=true
FEATURE_PLAYGROUND_QUERIES=true
FEATURE_PLAYGROUND_RULES=true
FEATURE_PLAYGROUND_ETL=false
FEATURE_ASSISTANT=false
FEATURE_OGC=true
