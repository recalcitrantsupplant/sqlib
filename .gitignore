scripts/**/*.js.map
*.log
# Fuseki fixture stores, wherever they sit. The old pattern was root-anchored,
# so the copies under packages/ were tracked for months without anyone meaning
# to commit them.
**/fuseki-test/databases*/
*.backup

# TypeScript compilation artifacts in src
#
# Deliberately every package, not just `api`: the rule was api-only, so
# `tsc` output committed under `packages/contracts/src/` (index.js + its map)
# sat in the tree as source for months. `.d.ts` stays api-only because other
# packages keep hand-written ambient shims next to their source
# (`web/src/vue-sonner.d.ts`, `mcp-server/src/shims.d.ts`).
#
# api has hand-written shims too, in `src/types/`. The blanket rule below
# swallowed them, which is how this repo shipped without
# `rdf-canonize.d.ts` and `ajv-formats-draft2019.d.ts` and could not build
# its own api package. Generated output never lands in `src/types/`, so
# un-ignoring that directory costs nothing and keeps the shims tracked.
packages/*/src/**/*.js
packages/*/src/**/*.js.map
# ...except the MCP App's kit, which is hand-written browser JavaScript, not
# build output. It is inlined verbatim into each View's <script> tag (the
# declared CSP lets a View load nothing at runtime), so it is authored as .js
# rather than compiled to it.
!packages/mcp-app/src/kit/*.js
packages/*/manual-tests/**/*.js
packages/*/manual-tests/**/*.js.map
packages/api/src/**/*.d.ts
!packages/api/src/types/*.d.ts

# Local persistent store (per-machine query library data)
local_store/

# Local MCP server config (machine-specific paths)
.mcp.json

# Temporary files
*.tmp
*.temp
*.bak
*.unused
*.old

