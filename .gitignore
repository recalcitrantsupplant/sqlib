.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Claude artifacts
.claude/
!data/examples/

# Private planning docs (business/strategy, never committed)
docs/private/

# runtime store artifacts
packages/api/tmp/

packages/srl/dist/

# Playwright artifacts (reports, traces, screenshots, .last-run.json)
playwright-report/
test-results/

# Runtime oxigraph stores (regenerated at run time)
tmp/library-store-docker/

# Playwright MCP session artifacts (console log dumps, screenshots).
.playwright-mcp/
